# ── Required ────────────────────────────────────────────────────────────────
# Wallet that receives x402 USDC payments. The server refuses to start without it.
PAY_TO_ADDRESS=0xYourMerchantWallet

# ── Payment network ─────────────────────────────────────────────────────────
# base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# x402 facilitator. Default is the public testnet facilitator.
FACILITATOR_URL=https://x402.org/facilitator

# ── Security (set BOTH before storing anything real) ────────────────────────
# HMAC-SHA256 key for signed link records and scoped tokens.
# Default: an insecure dev secret baked into src/sign.ts.
SIGNING_SECRET=
# AES-256-GCM key material (scrypt-derived) for credentials at rest.
# Falls back to SIGNING_SECRET, then to an insecure dev default.
VAULT_KEY=

# Require EIP-191 owner-wallet signatures on token mints and revocations.
# Defaults to true (unsigned allowed) so the local demo works without a signer.
# Set to false in production.
ALLOW_UNSIGNED_OWNER=true

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4021
